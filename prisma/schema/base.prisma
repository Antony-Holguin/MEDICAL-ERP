generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActionType {
  CREATE
  READ
  UPDATE
  DELETE
  LIST
  EXPORT
  IMPORT
  APPROVE
  REJECT
  MANAGE
}

enum LogLevel {
  INFO
  WARN
  ERROR
  CRITICAL
}
