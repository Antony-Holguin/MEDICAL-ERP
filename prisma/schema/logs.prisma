model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model SystemLog {
  id        BigInt   @id @default(autoincrement())
  level     LogLevel
  message   String
  service   String?
  context   Json?
  stack     String?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([service])
  @@index([createdAt])
}
